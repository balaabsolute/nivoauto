# ── Database ───────────────────────────────────────────────
# PostgreSQL (required in production). Leave unset in development to use embedded PGlite in ./.data/pglite
# DATABASE_URL=postgres://kun:change-me@localhost:5432/kun
# DATABASE_SSL=require
# DATABASE_POOL_MAX=10
# PGLITE_DIR=./.data/pglite
# ALLOW_PGLITE=1            # only for a single-machine demo under NODE_ENV=production

# ── Data mode ──────────────────────────────────────────────
# demo: demo rows visible with a banner; live: demo rows excluded and demo seeding refused
DATA_MODE=demo
# ALLOW_DEMO_SEED=1         # permit db:seed-demo under NODE_ENV=production (dedicated demo env only)

# ── Reporting conventions (confirm in discovery) ───────────
REPORTING_TZ=Asia/Kolkata
FY_START_MONTH=4
GP_MIN_COVERAGE=0.8
STALE_AFTER_HOURS=36

# ── Sessions & uploads ─────────────────────────────────────
SESSION_TTL_HOURS=12
# COOKIE_SECURE=false        # only if served over plain HTTP (not recommended)
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_MB=8

# ── Customer notifications ─────────────────────────────────
# console (simulated, dev default) | webhook | none (production default)
# NOTIFY_PROVIDER=webhook
# NOTIFY_WEBHOOK_URL=https://gateway.example/kun/notify
# NOTIFY_WEBHOOK_SECRET=change-me
# NOTIFY_WEBHOOK_CHANNELS=whatsapp,sms,email
# NOTIFY_MAX_ATTEMPTS=3

# ── Alert thresholds (placeholders to agree with Kun) ──────
# ALERT_TARGET_WARN_PCT=90
# ALERT_TARGET_CRIT_PCT=75
# ALERT_OVERDUE_CRIT=5
# ALERT_UTIL_HIGH=95
# ALERT_UTIL_LOW=50
# ALERT_MARGIN_DROP_PP=2
# ALERT_APPROVAL_WAIT_DAYS=3
